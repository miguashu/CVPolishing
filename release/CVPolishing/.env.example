# ===== CVPolishing 环境变量示例 =====
# 复制本文件为 .env 并填入真实值后启动服务。

# 大模型问答引擎（OpenAI 兼容接口，可指向 CodeBuddy / OpenAI / 本地 Ollama 等）
LLM_API_BASE=https://api.agicto.cn/v1
LLM_API_KEY=
LLM_MODEL=deepseek-v4-pro
LLM_TEMPERATURE=0.4
LLM_TIMEOUT=240

# 服务端口
PORT=5090

# 向量检索（长期记忆语义召回）：ollama | openai
EMBEDDING_PROVIDER=ollama
EMBEDDING_API_BASE=http://localhost:11434
EMBEDDING_API_KEY=ollama
EMBEDDING_MODEL=bge-m3
VECTOR_TOP_K=5

# 联网检索
SEARCH_FETCH_LIMIT=5
SEARCH_PER_LIMIT=2500
SEARCH_TOTAL_LIMIT=14000
SEARCH_ENABLED=true

# MySQL 配置（多用户登录 / 长期记忆 / 简历隔离）
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=cvpolishing

# Flask 会话签名密钥（生产环境务必改为随机强密钥）
SECRET_KEY=cvpolishing-dev-secret-key-change-me

# 会员激活码（留空则关闭「激活码开通」入口）
VIP_ACTIVATION_CODE=VIP2026
# 激活码开通后的有效期天数（0 或留空 = 永久会员）
VIP_DURATION_DAYS=0

# 技能 registry（联网查询 / 一键导入的来源）
SKILL_REGISTRY_URL=http://127.0.0.1:5090/api/skills/registry

# 可选：LangSmith 链路追踪（不配置则仅本地 JSONL 落盘，前端可视化不受影响）
# LANGSMITH_API_KEY=your_key
# LANGSMITH_API_URL=https://api.smith.langchain.com
# LANGSMITH_PROJECT=cvpolish
